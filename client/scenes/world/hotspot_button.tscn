[gd_scene format=3]

[node name="HotspotButton" type="Button"]
custom_minimum_size = Vector2(0, 48)
text = "Hotspot"

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 10

[node name="IconLabel" type="Label" parent="Row"]
layout_mode = 2
text = "?"

[node name="NameLabel" type="Label" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
text = "Hotspot"

[node name="ApLabel" type="Label" parent="Row"]
layout_mode = 2
text = "0 AP"

[node name="StatusDot" type="Label" parent="Row"]
layout_mode = 2
text = "*"
